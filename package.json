{
  "name": "math-modeling-tutor",
  "version": "0.1.0",
  "private": true,
  "author": "math-modeling-tutor",
  "description": "教学式数学建模 Agent 桌面应用（国赛引导式）",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/dist.mjs",
    "icons": "node scripts/make-icon.mjs",
    "setup:python": "py -3.12 -m pip install -r requirements-python.txt",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "smoke": "esbuild src/main/llm/openai-compat.ts --bundle --format=esm --platform=node --outfile=.tmp/openai-compat.mjs --log-level=warning && node tests/sse-smoke.mjs",
    "smoke:sandbox": "node tests/sandbox-smoke.mjs",
    "smoke:ui": "node tests/ui-probe.mjs",
    "smoke:agent": "node scripts/bundle-agent-test.mjs && node tests/agent-smoke.mjs",
    "smoke:latex": "esbuild src/main/latex/log.ts --bundle --format=esm --platform=node --outfile=.tmp/latex-log.mjs --log-level=warning && node tests/latex-smoke.mjs",
    "smoke:ui:stage": "node tests/ui-probe.mjs stage",
    "smoke:methods": "esbuild src/shared/methods.ts --bundle --format=esm --platform=node --outfile=.tmp/methods.mjs --log-level=warning && esbuild src/shared/stages.ts --bundle --format=esm --platform=node --outfile=.tmp/stages.mjs --log-level=warning && node tests/methods-smoke.mjs",
    "smoke:ui:paper": "node tests/ui-probe.mjs paper",
    "smoke:ui:methods": "node tests/ui-probe.mjs methods",
    "smoke:compliance": "esbuild src/shared/compliance.ts --bundle --format=esm --platform=node --outfile=.tmp/compliance.mjs --log-level=warning && node tests/compliance-smoke.mjs",
    "smoke:freechat": "esbuild src/shared/compliance.ts --bundle --format=esm --platform=node --outfile=.tmp/compliance.mjs --log-level=warning && esbuild src/main/agent/anti-ghostwrite.ts --bundle --format=esm --platform=node --outfile=.tmp/anti-ghostwrite.mjs --log-level=warning && node tests/freechat-smoke.mjs",
    "smoke:ui:compliance": "node tests/ui-probe.mjs compliance",
    "smoke:intake": "esbuild src/shared/intake.ts --bundle --format=esm --platform=node --outfile=.tmp/intake.mjs --log-level=warning && node tests/intake-smoke.mjs",
    "smoke:realdata": "esbuild src/shared/intake.ts --bundle --format=esm --platform=node --outfile=.tmp/intake.mjs --log-level=warning && node tests/real-data-preview-smoke.mjs",
    "smoke:evidence-flow": "esbuild src/shared/intake.ts --bundle --format=esm --platform=node --outfile=.tmp/intake.mjs --log-level=warning && esbuild src/shared/guidedQuiz.ts --bundle --format=esm --platform=node --outfile=.tmp/guidedQuiz.mjs --log-level=warning && node tests/guided-evidence-flow-smoke.mjs",
    "smoke:prediction": "esbuild src/shared/prediction.ts --bundle --format=esm --platform=node --outfile=.tmp/prediction.mjs --log-level=warning && node tests/prediction-baseline-smoke.mjs",
    "smoke:questions": "esbuild src/shared/questions.ts --bundle --format=esm --platform=node --outfile=.tmp/questions.mjs --log-level=warning && node tests/questions-smoke.mjs",
    "smoke:ui:questions": "node tests/ui-probe.mjs questions",
    "smoke:ui:quiz": "node tests/ui-probe.mjs quiz",
    "smoke:explain": "esbuild src/shared/explain.ts --bundle --format=esm --platform=node --outfile=.tmp/explain.mjs --log-level=warning && esbuild src/shared/methods.ts --bundle --format=esm --platform=node --outfile=.tmp/methods.mjs --log-level=warning && node tests/explain-smoke.mjs",
    "smoke:plots": "esbuild src/shared/plots.ts --bundle --format=esm --platform=node --outfile=.tmp/plots.mjs --log-level=warning && node tests/plots-smoke.mjs",
    "smoke:guided": "esbuild src/shared/guidedQuiz.ts --bundle --format=esm --platform=node --outfile=.tmp/guidedQuiz.mjs --log-level=warning && node tests/guided-smoke.mjs",
    "smoke:ui:plot": "node tests/ui-probe.mjs plot"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "katex": "^0.16.22",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
