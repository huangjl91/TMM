{
  "name": "math-modeling-tutor",
  "version": "0.1.0",
  "private": true,
  "author": "math-modeling-tutor",
  "description": "教学式数学建模 Agent 桌面应用（国赛引导式）",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "node scripts/dist.mjs",
    "icons": "node scripts/make-icon.mjs",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "smoke": "esbuild src/main/llm/openai-compat.ts --bundle --format=esm --platform=node --outfile=.tmp/openai-compat.mjs --log-level=warning && node tests/sse-smoke.mjs",
    "smoke:sandbox": "node tests/sandbox-smoke.mjs",
    "smoke:ui": "node tests/ui-probe.mjs",
    "smoke:agent": "node scripts/bundle-agent-test.mjs && node tests/agent-smoke.mjs",
    "smoke:latex": "esbuild src/main/latex/log.ts --bundle --format=esm --platform=node --outfile=.tmp/latex-log.mjs --log-level=warning && node tests/latex-smoke.mjs",
    "smoke:ui:stage": "node tests/ui-probe.mjs stage",
    "smoke:methods": "esbuild src/shared/methods.ts --bundle --format=esm --platform=node --outfile=.tmp/methods.mjs --log-level=warning && esbuild src/shared/stages.ts --bundle --format=esm --platform=node --outfile=.tmp/stages.mjs --log-level=warning && node tests/methods-smoke.mjs",
    "smoke:ui:paper": "node tests/ui-probe.mjs paper",
    "smoke:ui:methods": "node tests/ui-probe.mjs methods",
    "smoke:compliance": "esbuild src/shared/compliance.ts --bundle --format=esm --platform=node --outfile=.tmp/compliance.mjs --log-level=warning && node tests/compliance-smoke.mjs",
    "smoke:ui:compliance": "node tests/ui-probe.mjs compliance"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
